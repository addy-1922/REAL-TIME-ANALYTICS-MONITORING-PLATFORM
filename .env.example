# Copy this file to .env and update every production value.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,real-time-analytics-monitoring-platform.onrender.com
CSRF_TRUSTED_ORIGINS=

# Leave database values blank to use local SQLite.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=monitoring@example.com

SLOW_REQUEST_THRESHOLD=1000
EVENT_RETENTION_DAYS=90
ANALYTICS_CACHE_TTL=30
ERROR_SPIKE_THRESHOLD=5
ERROR_SPIKE_MULTIPLIER=3
